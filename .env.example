# Copy to .env (local dev) and set the same names in Vercel > Settings > Environment Variables.
OPENAI_API_KEY=
# Read-only fine-grained token (Contents: read, Pull requests: read, Metadata: read).
GITHUB_TOKEN=
# Any OpenAI model that supports Structured Outputs. Leave empty for the default in shared/config.js.
OPENAI_MODEL=
# Optional, only for reasoning models: low | medium | high
OPENAI_REASONING_EFFORT=
# Set to 1 to fake the AI step (UI demos without spending tokens)
MOCK_LLM=
